# 标航智导环境变量样例：复制为 .env.local 并填入真实值（.env.local 永不提交）
# 所有服务变量统一 BHZD_ 前缀；配置定义见 server/bhzd_py/config.py（蓝图 §3）。

# ---- 服务 ----
NODE_ENV=development
BHZD_HOST=127.0.0.1
BHZD_PORT=8787
# 前端开发源（CORS 默认放行它；BHZD_CORS_ORIGINS 为空时以此为准）
BHZD_PUBLIC_ORIGIN=http://127.0.0.1:5173
# 逗号分隔的 CORS 放行源列表；留空 = 仅放行 BHZD_PUBLIC_ORIGIN（同源策略）
# BHZD_CORS_ORIGINS=

# ---- 存储 ----
# SQLite 数据库路径（相对路径按仓库根解析）；默认 <repo>/var/bhzd.sqlite
# 测试/多环境隔离时覆盖它即可
# BHZD_DATABASE_PATH=./var/bhzd.sqlite
# 旧名兼容：仅在 BHZD_DATABASE_PATH 未设置时生效，优先级低于新名
# BHZD_DATABASE_URL=sqlite:///./var/bhzd.sqlite
# 内容数据目录（图谱/教学单元/场景，运行时只读加载）；默认 <repo>/data
# BHZD_DATA_DIR=./data
# 上传文件存储目录；默认 <repo>/var/uploads
# BHZD_UPLOAD_DIR=./var/uploads
# 自定义向量库预留位（当前向量存 SQLite BLOB，此项留空）
BHZD_VECTOR_STORE_URL=

# ---- 密钥与初始管理员 ----
# provider API Key 的 AES-256-GCM 加密密钥：hex 或 base64 编码的 32 字节。
# 不配置则启动时生成临时开发密钥并告警——重启后旧密文无法解密，生产必配！
# 生成方法：
#   python -c "import secrets; print(secrets.token_hex(32))"
BHZD_CONFIG_ENCRYPTION_KEY=<32-byte-hex-or-base64>
# 初始系统管理员邮箱（seed 时创建）
BHZD_ADMIN_EMAIL=admin@bhzd.local
# 初始管理员明文密码（仅 seed 首次创建时使用）；留空则生成随机密码并打印一次
# BHZD_ADMIN_PASSWORD=
# 旧名兼容：直接提供 argon2id 哈希（优先于明文密码）。生成方法：
#   python -c "import getpass, sys; sys.path.insert(0, 'server'); from bhzd_py.security import hash_password; print(hash_password(getpass.getpass('Admin password: ')))"
# BHZD_ADMIN_PASSWORD_HASH=<argon2id-hash>

# ---- 会话 ----
# 会话有效期（小时）
BHZD_SESSION_TTL_HOURS=72

# ---- 邮件 ----
# 未配置 SMTP 时，验证/重置链接写入 <repo>/var/mail_outbox.log 并在 API dev 字段返回
BHZD_SMTP_HOST=
BHZD_SMTP_PORT=587
BHZD_SMTP_SECURE=false
BHZD_SMTP_USER=
BHZD_SMTP_PASS=
BHZD_MAIL_FROM="标航智导 <noreply@bhzd.local>"

# ---- 演示模式 ----
# 开启后允许演示数据相关行为（演示账号由 python -m bhzd_py.seed.loader --demo 创建）
BHZD_DEMO_MODE=false

# ---- 注册 ----
# 教师自注册邀请码（学生注册不需要）；默认值仅用于开发，生产环境务必改为私有值
BHZD_TEACHER_INVITE_CODE=bhzd-teacher-2026

# 登录限流阈值（次/分钟/IP，NF5）。生产请勿设置（默认 5 即安全值）；
# 仅本地开发 / e2e 联调时放宽，例如 60
# BHZD_LOGIN_RATE_LIMIT_PER_MINUTE=5
