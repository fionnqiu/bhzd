{
  "schema_version": "1.1.0",
  "data_type": "audio",
  "units": [
    {
      "id": "TU-AUDIO-LANGUAGE-DIALECT-001",
      "data_type": "audio",
      "title": "按可听证据标注语种与方言",
      "capability_key": "language_dialect",
      "goals": [
        "依据可听语言证据选择项目配置内的语种或方言标签",
        "在混码或证据不足时使用确定性的 mixed 或 und 表示"
      ],
      "learning_objectives": [
        "区分 BCP 47 标签格式事实与本项目的语种方言判定策略",
        "拒绝依据说话人地区、姓名或其他不可听属性推断方言",
        "按既定错误优先级诊断未配置标签、证据不符、混码折叠和过度分类"
      ],
      "prerequisites": [
        "CAP-AUD-TRANSCRIBE-PUNCT-001"
      ],
      "rule_refs": [
        "KNG-AUD-LANGUAGE-DIALECT-001"
      ],
      "source_refs": [
        "SRC-IETF-RFC5646-001",
        "SRC-IANA-LANGUAGE-SUBTAG-001",
        "SRC-POLICY-AUDIO-TASK4-001"
      ],
      "rule_explanation": {
        "external_format_facts": [
          {
            "statement": "RFC 5646 说明语言标签可由语言、脚本、地区和变体等子标签组成，但不替具体标注项目决定某段录音应使用哪个标签。",
            "source_refs": [
              "SRC-IETF-RFC5646-001"
            ]
          },
          {
            "statement": "IANA Language Subtag Registry 提供已登记子标签的查询事实，例如普通话语言子标签 cmn，但不提供基于声音判断方言或混码的项目判定规则。",
            "source_refs": [
              "SRC-IANA-LANGUAGE-SUBTAG-001"
            ]
          }
        ],
        "project_policy": {
          "source_ref": "SRC-POLICY-AUDIO-TASK4-001",
          "statement": "本项目草稿策略只允许从 configured_labels 原样选择标签：单一且证据充分的语段标为对应语言或方言；同一语段包含两种可辨识语言时标为 mixed；证据不足时标为 und；不得根据姓名、地区或其他不可听属性推断。该策略不是 RFC 或 IANA 的外部标准。",
          "version": "1.0.0"
        }
      },
      "positive_examples": [
        {
          "id": "EX-AUDIO-LANGUAGE-POS-001",
          "asset_ref": "ASSET-SELF-AUDIO-LANGUAGE-001",
          "input": {
            "segment_id": "LANG-POS-01",
            "audible_cues": [
              "完整可辨识粤语词句",
              "无其他语言词项"
            ],
            "configured_labels": [
              "en",
              "mixed",
              "und",
              "yue",
              "cmn"
            ]
          },
          "expected": {
            "language_tag": "yue"
          },
          "explanation": "可听证据只支持粤语，且 yue 是配置内标签，因此确定性选择 yue。",
          "source_ref": "SRC-POLICY-AUDIO-TASK4-001",
          "asset_authorization": {
            "type": "self-authored",
            "representation": "structured_fixture",
            "student_use_allowed": true
          }
        }
      ],
      "negative_examples": [
        {
          "id": "EX-AUDIO-LANGUAGE-NEG-001",
          "asset_ref": "ASSET-SELF-AUDIO-LANGUAGE-002",
          "input": {
            "segment_id": "LANG-NEG-01",
            "audible_cues": [
              "完整可辨识粤语词句"
            ],
            "speaker_profile_hint": "常住北京",
            "configured_labels": [
              "en",
              "mixed",
              "und",
              "yue",
              "cmn"
            ],
            "submitted": {
              "language_tag": "cmn"
            }
          },
          "expected": {
            "valid": false,
            "error": "language_evidence_mismatch"
          },
          "explanation": "常住地不是可听语言证据；提交结果与明确的粤语声音证据不符。",
          "source_ref": "SRC-POLICY-AUDIO-TASK4-001",
          "asset_authorization": {
            "type": "self-authored",
            "representation": "structured_fixture",
            "student_use_allowed": true
          }
        }
      ],
      "exercise": {
        "exercise_id": "EXERCISE-AUDIO-LANGUAGE-DIALECT-001",
        "exercise_type": "segment_language_classification",
        "asset_ref": "ASSET-SELF-AUDIO-LANGUAGE-EXERCISE-001",
        "input": {
          "configured_labels": [
            "en",
            "mixed",
            "und",
            "yue",
            "cmn"
          ],
          "policy_version": "1.0.0",
          "segments": [
            {
              "segment_id": "LANG-01",
              "audible_cues": [
                "完整可辨识普通话句子",
                "无其他语言词项"
              ]
            },
            {
              "segment_id": "LANG-02",
              "audible_cues": [
                "可辨识英语词 please",
                "可辨识普通话短语 打开导航"
              ]
            },
            {
              "segment_id": "LANG-03",
              "audible_cues": [
                "强噪声覆盖",
                "只有一个无法确认语言的音节"
              ]
            }
          ]
        },
        "student_action": "按 segments 顺序提交 labels；每项只包含 segment_id 和一个 configured_labels 内的 language_tag。",
        "answer": {
          "labels": [
            {
              "segment_id": "LANG-01",
              "language_tag": "cmn"
            },
            {
              "segment_id": "LANG-02",
              "language_tag": "mixed"
            },
            {
              "segment_id": "LANG-03",
              "language_tag": "und"
            }
          ]
        },
        "evaluation": {
          "method": "ordered_exact_match",
          "version": "1.1.0",
          "response_space": {
            "type": "finite_closed_set",
            "recognized_submissions": [
              "standard_answer",
              "diagnostic_rules"
            ],
            "unmatched_behavior": "manual_review"
          },
          "normalization": "JSON 对象键顺序忽略；labels 数组顺序、segment_id 和 language_tag 必须完全一致；标签区分大小写且不自动 trim。",
          "diagnostic_precedence": "diagnostic_rules 按数组顺序严格匹配，依次优先处理未配置标签、可听证据不符、混码折叠、证据不足时过度分类；首个命中规则生效，之后才匹配标准答案，最后使用 incorrect_feedback。",
          "manual_review_on_unmatched": true,
          "diagnostic_rules": [
            {
              "submission": {
                "labels": [
                  {
                    "segment_id": "LANG-01",
                    "language_tag": "zh-Hans-CN"
                  },
                  {
                    "segment_id": "LANG-02",
                    "language_tag": "mixed"
                  },
                  {
                    "segment_id": "LANG-03",
                    "language_tag": "und"
                  }
                ]
              },
              "error_type": "language_tag_not_configured",
              "feedback": "zh-Hans-CN 即使可作为语言标签形式，也不在本题 configured_labels 中。",
              "remediation": [
                "先使用语种方言标签卡核对 configured_labels，再原样选择 cmn。"
              ]
            },
            {
              "submission": {
                "labels": [
                  {
                    "segment_id": "LANG-01",
                    "language_tag": "yue"
                  },
                  {
                    "segment_id": "LANG-02",
                    "language_tag": "mixed"
                  },
                  {
                    "segment_id": "LANG-03",
                    "language_tag": "und"
                  }
                ]
              },
              "error_type": "language_evidence_mismatch",
              "feedback": "LANG-01 的可听证据是普通话，不支持 yue。",
              "remediation": [
                "只依据 audible_cues 重新选择 cmn，不使用说话人背景信息推断。"
              ]
            },
            {
              "submission": {
                "labels": [
                  {
                    "segment_id": "LANG-01",
                    "language_tag": "cmn"
                  },
                  {
                    "segment_id": "LANG-02",
                    "language_tag": "cmn"
                  },
                  {
                    "segment_id": "LANG-03",
                    "language_tag": "und"
                  }
                ]
              },
              "error_type": "code_switch_collapsed",
              "feedback": "LANG-02 同时包含可辨识英语和普通话，不能折叠为单一 cmn。",
              "remediation": [
                "在语种方言标签卡中复核 mixed 规则，并将 LANG-02 改为 mixed。"
              ]
            },
            {
              "submission": {
                "labels": [
                  {
                    "segment_id": "LANG-01",
                    "language_tag": "cmn"
                  },
                  {
                    "segment_id": "LANG-02",
                    "language_tag": "mixed"
                  },
                  {
                    "segment_id": "LANG-03",
                    "language_tag": "yue"
                  }
                ]
              },
              "error_type": "uncertain_audio_overclassified",
              "feedback": "LANG-03 的语言证据不足，不能强制判为 yue。",
              "remediation": [
                "证据不足时使用项目配置内的 und，不猜测具体语言或方言。"
              ]
            }
          ],
          "correct_feedback": "三段语音均按可听证据、混码规则和不确定性规则完成标注。",
          "incorrect_feedback": {
            "error_type": "unclassified_submission",
            "feedback": "提交未命中标准答案或任何已声明诊断规则，无法安全归入某个具体错误。",
            "remediation": [
              "按有限响应集合重新提交；若多个错误同时存在，保留证据并请求人工复核。"
            ]
          }
        },
        "data_version": "1.1.0",
        "pass_condition": "score == 1.0",
        "capability_refs": [
          "CAP-AUD-LANGUAGE-DIALECT-001"
        ],
        "error_types": [
          "language_tag_not_configured",
          "language_evidence_mismatch",
          "code_switch_collapsed",
          "uncertain_audio_overclassified",
          "unclassified_submission"
        ],
        "asset_authorization": {
          "type": "self-authored",
          "representation": "structured_fixture",
          "student_use_allowed": true
        }
      },
