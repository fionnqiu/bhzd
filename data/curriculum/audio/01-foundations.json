    {
      "id": "TU-AUDIO-SPEAKER-TURNS-001",
      "data_type": "audio",
      "title": "按时间线保持说话人轮次一致",
      "capability_key": "speaker_turns",
      "goals": [
        "按时间顺序划分说话人轮次并保持身份标签稳定",
        "对轮次数量、顺序、身份和边界错误给出确定性诊断"
      ],
      "learning_objectives": [
        "理解外部转写格式中的说话人和时间字段不等于项目身份分配策略",
        "按首次出现顺序分配 spk_01、spk_02 并在后续轮次复用",
        "按声明的错误优先级修复轮次数量、顺序、身份和边界"
      ],
      "prerequisites": [
        "CAP-AUD-CONFIG-VALIDATE-001"
      ],
      "rule_refs": [
        "KNG-AUD-SPEAKER-TURN-001",
        "KNG-AUD-EXPORT-FORMAT-001"
      ],
      "source_refs": [
        "SRC-NIST-SCTK-FORMATS-001",
        "SRC-POLICY-AUDIO-TASK4-001"
      ],
      "rule_explanation": {
        "external_format_facts": [
          {
            "statement": "NIST SCTK 的 STM 格式包含说话人、begin/end 时间和转写文本等字段，可用于表达说话人片段；该格式不规定本练习的说话人编号方式或错误优先级。",
            "source_refs": [
              "SRC-NIST-SCTK-FORMATS-001"
            ]
          }
        ],
        "project_policy": {
          "source_ref": "SRC-POLICY-AUDIO-TASK4-001",
          "statement": "本项目草稿策略要求 turns 按 start_ms 升序提交；不同可辨识声音按首次出现顺序分配 spk_01、spk_02，后续同一声音必须复用原标签；turn 边界必须与提供的 handoff_ms 一致。该编号和诊断顺序是项目策略，不是 STM 外部标准。",
          "version": "1.0.0"
        }
      },
      "positive_examples": [
        {
          "id": "EX-AUDIO-SPEAKER-POS-001",
          "asset_ref": "ASSET-SELF-AUDIO-SPEAKER-001",
          "input": {
            "voice_sequence": [
              "voice_alpha",
              "voice_beta",
              "voice_alpha"
            ],
            "handoff_ms": [
              1000,
              2200
            ]
          },
          "expected": {
            "speaker_ids": [
              "spk_01",
              "spk_02",
              "spk_01"
            ]
          },
          "explanation": "voice_alpha 在第三轮再次出现，因此必须复用首次分配的 spk_01。",
          "source_ref": "SRC-POLICY-AUDIO-TASK4-001",
          "asset_authorization": {
            "type": "self-authored",
            "representation": "structured_fixture",
            "student_use_allowed": true
          }
        }
      ],
      "negative_examples": [
        {
          "id": "EX-AUDIO-SPEAKER-NEG-001",
          "asset_ref": "ASSET-SELF-AUDIO-SPEAKER-002",
          "input": {
            "voice_sequence": [
              "voice_alpha",
              "voice_beta",
              "voice_alpha"
            ],
            "submitted_speaker_ids": [
              "spk_01",
              "spk_02",
              "spk_03"
            ]
