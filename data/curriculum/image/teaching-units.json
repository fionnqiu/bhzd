{
  "schema_version": "1.1.0",
  "data_type": "image",
  "units": [
    {
      "id": "TU-IMAGE-KEYPOINT-VISIBILITY-001",
      "data_type": "image",
      "title": "判定关键点可见性",
      "learning_objectives": [
        "区分可见、被遮挡和位于画面外的关键点状态",
        "按本项目规则决定是否保留关键点坐标"
      ],
      "prerequisites": [
        "CAP-IMG-OBJECT-CLASS-001"
      ],
      "rule_refs": [
        "KNG-IMG-KEYPOINT-VISIBILITY-001",
        "KNG-IMG-SMALL-OBJECT-001"
      ],
      "source_refs": [
        "SRC-CVAT-ANNOTATION-FORMAT-251",
        "SRC-POLICY-IMAGE-TASK3-001"
      ],
      "rule_explanation": "外部格式事实（SRC-CVAT-ANNOTATION-FORMAT-251）：图像关键点可由点几何及其属性表达；该事实不规定本课程的可见性枚举或坐标保留规则。 本项目本地语义策略（SRC-POLICY-IMAGE-TASK3-001；KNG-IMG-SMALL-OBJECT-001）：visibility 只能是 visible、occluded、outside_image。关键点在画面内且可直接观察时为 visible；在画面内、有明确前景遮挡证据且位置可确定时为 occluded；关键点在画面外时为 outside_image。visible 与 occluded 必须保留确定坐标，outside_image 坐标必须为 null。证据不足或位置不可确定时进入 unknown 工作流，unknown 不是 visibility 枚举值，不得作为 visibility 提交。",
      "visibility_policy": {
        "visibility_enum": ["visible", "occluded", "outside_image"],
        "coordinate_rules": {
          "visible": "coordinates_required_and_retained",
          "occluded": "coordinates_required_and_retained_when_position_determinable",
          "outside_image": "coordinates_must_be_null"
        },
        "unknown_workflow": {
          "is_visibility_value": false,
          "trigger": "画面内关键点缺少足以区分直接可见与前景遮挡的证据，或遮挡后位置不可确定",
          "submission": {"decision": "unknown", "visibility": null, "coordinates": null},
          "requires_manual_review": true
        }
      },
      "positive_examples": [
        {
          "id": "EX-IMAGE-KEYPOINT-POS-001",
          "asset_ref": "ASSET-SELF-IMAGE-KEYPOINT-001",
          "input": {
            "keypoint": "left_wrist",
            "in_image": true,
            "directly_visible": false,
            "position_determinable": true,
            "foreground_occlusion_evidence": {
              "present": true,
              "occluder": "foreground_railing",
              "hidden_region": "left_wrist"
            },
            "coordinates": {"x": 148, "y": 203}
          },
          "expected": {
            "visibility": "occluded",
            "coordinates": {"x": 148, "y": 203}
          },
          "explanation": "手腕在画面内且位置可确定，但被前景物体遮挡，因此使用 occluded 并保留坐标。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "negative_examples": [
        {
          "id": "EX-IMAGE-KEYPOINT-NEG-001",
          "asset_ref": "ASSET-SELF-IMAGE-KEYPOINT-002",
          "input": {
            "keypoint": "left_wrist",
            "in_image": true,
            "directly_visible": false,
            "position_determinable": true,
            "foreground_occlusion_evidence": {
              "present": true,
              "occluder": "foreground_railing",
              "hidden_region": "left_wrist"
            },
            "submitted": {
              "visibility": "visible",
              "coordinates": {"x": 148, "y": 203}
            }
          },
          "expected": {
            "valid": false,
            "error": "keypoint_visibility_misclassified",
            "details": {
              "required_visibility": "occluded"
            }
          },
          "explanation": "前景栏杆明确遮挡画面内手腕，且坐标可确定；提交仅把 occluded 错写为 visible，坐标本身保持正确。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        },
        {
          "id": "EX-IMAGE-KEYPOINT-NEG-002",
          "asset_ref": "ASSET-SELF-IMAGE-KEYPOINT-003",
          "input": {
            "keypoint": "right_ankle",
            "in_image": false,
            "foreground_occlusion_evidence": {
              "present": false,
              "reason": "关键点位于图像边界之外"
            },
            "submitted": {
              "visibility": "outside_image",
              "coordinates": {"x": 639, "y": 470}
            }
          },
          "expected": {
            "valid": false,
            "error": "outside_image_coordinates_present",
            "details": {"required_coordinates": null}
          },
          "explanation": "outside_image 状态正确，但本地策略禁止为画面外关键点猜测边缘坐标。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        },
        {
          "id": "EX-IMAGE-KEYPOINT-NEG-003",
          "asset_ref": "ASSET-SELF-IMAGE-KEYPOINT-004",
          "input": {
            "keypoint": "right_elbow",
            "in_image": true,
            "directly_visible": false,
            "position_determinable": false,
            "foreground_occlusion_evidence": {
              "present": false,
              "reason": "证据不足，无法确认是前景遮挡还是低对比度"
            },
            "submitted": {"visibility": "unknown", "coordinates": null}
          },
          "expected": {
            "valid": false,
            "error": "unknown_as_visibility",
            "details": {
              "allowed_visibility_values": ["visible", "occluded", "outside_image"],
              "required_workflow_decision": "unknown"
            }
          },
          "explanation": "证据不足时应进入 unknown 人工复核工作流；unknown 不是 visibility 枚举值。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "exercise": {
        "asset_ref": "ASSET-SELF-IMAGE-KEYPOINT-EXERCISE-001",
        "input": {
          "allowed_visibility_values": ["visible", "occluded", "outside_image"],
          "unknown_is_visibility_value": false,
          "cases": [
            {
              "case_id": "KP-VISIBLE",
              "keypoint": "nose",
              "in_image": true,
              "directly_visible": true,
              "position_determinable": true,
              "foreground_occlusion_evidence": {"present": false},
              "coordinates": {"x": 160, "y": 72}
            },
            {
              "case_id": "KP-OCCLUDED",
              "keypoint": "left_knee",
              "in_image": true,
              "directly_visible": false,
              "position_determinable": true,
              "foreground_occlusion_evidence": {
                "present": true,
                "occluder": "foreground_table_edge",
                "hidden_region": "left_knee"
              },
              "coordinates": {"x": 212, "y": 356}
            },
            {
              "case_id": "KP-OUTSIDE",
              "keypoint": "right_ankle",
              "in_image": false,
              "directly_visible": false,
              "position_determinable": false,
              "foreground_occlusion_evidence": {
                "present": false,
                "reason": "关键点位于图像边界之外"
              },
              "coordinates": null
            }
          ]
        },
        "student_action": "按 cases 数组顺序提交 annotations；每项给出 case_id、visibility 和 coordinates。unknown 只用于复核工作流，不得作为 visibility。",
        "answer": {
          "annotations": [
            {
              "case_id": "KP-VISIBLE",
              "visibility": "visible",
              "coordinates": {"x": 160, "y": 72}
            },
            {
              "case_id": "KP-OCCLUDED",
              "visibility": "occluded",
              "coordinates": {"x": 212, "y": 356}
            },
            {
              "case_id": "KP-OUTSIDE",
              "visibility": "outside_image",
              "coordinates": null
            }
          ]
        },
        "evaluation": {
          "method": "exact_match",
          "version": "1.1.0",
          "normalization": "JSON 对象键顺序忽略；annotations 数组顺序、visibility 字符串和坐标值必须完全一致。diagnostic_rules 按数组顺序匹配，首个 exact submission 命中；数组顺序即错误优先级。",
          "diagnostic_precedence": "array_order_first_exact_match",
          "diagnostic_rules": [
            {
              "submission": {
                "annotations": [
                  {"case_id": "KP-VISIBLE", "visibility": "visible", "coordinates": {"x": 160, "y": 72}},
                  {"case_id": "KP-OCCLUDED", "visibility": "visible", "coordinates": {"x": 212, "y": 356}},
                  {"case_id": "KP-OUTSIDE", "visibility": "outside_image", "coordinates": null}
                ]
              },
              "error_type": "keypoint_visibility_misclassified",
              "feedback": "KP-OCCLUDED 有明确前景遮挡证据，应标为 occluded，而不是 visible。",
              "remediation": [
                "核对 foreground_occlusion_evidence.present；画面内、有前景遮挡且位置可确定时提交 occluded。"
              ]
            },
            {
              "submission": {
                "annotations": [
                  {"case_id": "KP-VISIBLE", "visibility": "visible", "coordinates": {"x": 160, "y": 72}},
                  {"case_id": "KP-OCCLUDED", "visibility": "occluded", "coordinates": null},
                  {"case_id": "KP-OUTSIDE", "visibility": "outside_image", "coordinates": null}
                ]
              },
              "error_type": "keypoint_coordinates_dropped",
              "feedback": "KP-OCCLUDED 的位置可确定，occluded 状态必须保留坐标。",
              "remediation": [
                "恢复输入中 KP-OCCLUDED 的确定坐标；只有 outside_image 使用 null 坐标。"
              ]
            },
            {
              "submission": {
                "annotations": [
                  {"case_id": "KP-VISIBLE", "visibility": "visible", "coordinates": {"x": 160, "y": 72}},
                  {"case_id": "KP-OCCLUDED", "visibility": "occluded", "coordinates": {"x": 212, "y": 356}},
                  {"case_id": "KP-OUTSIDE", "visibility": "outside_image", "coordinates": {"x": 639, "y": 479}}
                ]
              },
              "error_type": "outside_image_coordinates_present",
              "feedback": "KP-OUTSIDE 位于画面外，coordinates 必须为 null。",
              "remediation": [
                "删除猜测的边缘坐标，并为 outside_image 提交 null。"
              ]
            },
            {
              "submission": {
                "annotations": [
                  {"case_id": "KP-VISIBLE", "visibility": "visible", "coordinates": {"x": 160, "y": 72}},
                  {"case_id": "KP-OCCLUDED", "visibility": "unknown", "coordinates": {"x": 212, "y": 356}},
                  {"case_id": "KP-OUTSIDE", "visibility": "outside_image", "coordinates": null}
                ]
              },
              "error_type": "unknown_as_visibility",
              "feedback": "unknown 不是 visibility 枚举值；本案例证据足以确定为 occluded。",
              "remediation": [
                "只从 visible、occluded、outside_image 中提交 visibility；证据不足时改走 unknown 人工复核工作流。"
              ]
            }
          ],
          "incorrect_feedback": {
            "error_type": "keypoint_visibility_misclassified",
            "feedback": "关键点状态或坐标保留规则与本地可见性策略不一致。",
            "remediation": [
              "先判断关键点是否在画面内，再判断是否直接可见；只有 outside_image 使用 null 坐标。"
            ]
          }
        },
        "data_version": "1.1.0",
        "pass_condition": "score == 1.0",
        "capability_refs": [
          "CAP-IMG-KEYPOINT-001"
        ],
        "error_types": [
          "keypoint_visibility_misclassified",
          "keypoint_coordinates_dropped",
          "outside_image_coordinates_present",
          "unknown_as_visibility"
        ],
        "asset_authorization": {
          "type": "self-authored",
          "student_use_allowed": true
        }
      },
      "common_errors": [
        "把画面外关键点误判为画面内遮挡",
        "对位置可确定的被遮挡关键点删除坐标",
        "为 outside_image 猜测边缘坐标",
        "把 unknown 当成第四个 visibility 枚举值"
      ],
      "remediation": [
        "按在画面内、直接可见、位置可确定三个条件依次复核状态与坐标"
      ],
      "review_records": [],
      "review_status": "draft",
      "student_visible": false
    },
    {
      "id": "TU-IMAGE-MASK-INSTANCE-001",
      "data_type": "image",
      "title": "区分语义掩码与实例掩码",
      "learning_objectives": [
        "区分语义分割的类别像素与实例分割的独立对象掩码",
        "按本项目规则绑定实例 ID 和实例属性"
      ],
      "prerequisites": [
        "CAP-IMG-SEMANTIC-SEGMENT-001"
      ],
      "rule_refs": [
        "KNG-IMG-SEMANTIC-MASK-001",
        "KNG-IMG-INSTANCE-ID-001",
        "KNG-IMG-QUALITY-METRICS-001"
      ],
      "source_refs": [
        "SRC-CVAT-ANNOTATION-FORMAT-251",
        "SRC-POLICY-IMAGE-TASK3-001"
      ],
      "rule_explanation": "外部格式事实（SRC-CVAT-ANNOTATION-FORMAT-251）：掩码几何可与标签一起保存，多个带标签的掩码实例可以分别保存；该事实不规定课程的实例 ID 命名或属性作用域。 本项目本地语义策略（SRC-POLICY-IMAGE-TASK3-001；KNG-IMG-QUALITY-METRICS-001）：semantic 模式只输出每个像素的 class_label，同类区域不分配 instance_id，且不绑定对象级属性；instance 模式为每个独立对象保留独立掩码，instance_id 必须按 {class_label}-{object_index:02d} 生成，object_index 从 1 开始，同一类别内唯一。required_attributes 必须只绑定到对应实例；属性不改变像素类别，也不替代 instance_id。",
      "instance_policy": {
        "instance_id_template": "{class_label}-{object_index:02d}",
        "object_index_origin": 1,
        "uniqueness_scope": "within_class_label_and_asset",
        "semantic_mode": {
          "instance_id": null,
          "object_attributes_allowed": false
        },
        "instance_mode": {
          "instance_id_required": true,
          "required_attributes_scope": "matching_instance_only"
        }
      },
      "positive_examples": [
        {
          "id": "EX-IMAGE-MASK-POS-001",
          "asset_ref": "ASSET-SELF-IMAGE-MASK-001",
          "input": {
            "mode": "semantic",
            "region": "road_pixels",
            "class_label": "road"
          },
          "expected": {
            "class_label": "road",
            "instance_id": null,
            "attributes": {}
          },
          "explanation": "semantic 模式只保留像素类别，不为道路区域创建实例 ID 或对象级属性。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        },
        {
          "id": "EX-IMAGE-MASK-POS-002",
          "asset_ref": "ASSET-SELF-IMAGE-MASK-002",
          "input": {
            "mode": "instance",
            "class_label": "car",
            "object_index": 2,
            "required_attributes": ["occluded"],
            "observed_attributes": {"occluded": true}
          },
          "expected": {
            "class_label": "car",
            "instance_id": "car-02",
            "attributes": {"occluded": true},
            "merge_with_same_class": false
          },
          "explanation": "instance 模式按 {class_label}-{object_index:02d} 将第二辆车命名为 car-02，并把必填属性只绑定到该实例。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "negative_examples": [
        {
          "id": "EX-IMAGE-MASK-NEG-001",
          "asset_ref": "ASSET-SELF-IMAGE-MASK-003",
          "input": {
            "mode": "instance",
            "class_label": "person",
            "object_index": 1,
            "required_attributes": [],
            "submitted": {
              "class_label": "person",
              "instance_id": null,
              "attributes": {},
              "merge_with_same_class": false
            }
          },
          "expected": {
            "valid": false,
            "error": "instance_id_missing"
          },
          "explanation": "其余字段均正确，唯一错误是 instance 模式缺少按模板生成的 person-01。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        },
        {
          "id": "EX-IMAGE-MASK-NEG-002",
          "asset_ref": "ASSET-SELF-IMAGE-MASK-004",
          "input": {
            "mode": "semantic",
            "class_label": "sky",
            "submitted": {
              "class_label": "sky",
              "instance_id": null,
              "attributes": {"occluded": false}
            }
          },
          "expected": {
            "valid": false,
            "error": "attribute_scope_invalid"
          },
          "explanation": "类别和空 instance_id 均正确，唯一错误是在 semantic 模式绑定对象级属性。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        },
        {
          "id": "EX-IMAGE-MASK-NEG-003",
          "asset_ref": "ASSET-SELF-IMAGE-MASK-005",
          "input": {
            "mode": "instance",
            "class_label": "car",
            "object_index": 2,
            "required_attributes": ["occluded"],
            "observed_attributes": {"occluded": true},
            "submitted": {
              "class_label": "car",
              "instance_id": "car-2",
              "attributes": {"occluded": true},
              "merge_with_same_class": false
            }
          },
          "expected": {
            "valid": false,
            "error": "instance_id_format_invalid",
            "details": {
              "template": "{class_label}-{object_index:02d}",
              "required_instance_id": "car-02"
            }
          },
          "explanation": "其余实例字段均正确，唯一错误是 object_index 未按两位十进制补零。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        },
        {
          "id": "EX-IMAGE-MASK-NEG-004",
          "asset_ref": "ASSET-SELF-IMAGE-MASK-006",
          "input": {
            "mode": "semantic",
            "region": "road_pixels",
            "class_label": "road",
            "submitted": {
              "class_label": "sidewalk",
              "instance_id": null,
              "attributes": {}
            }
          },
          "expected": {
            "valid": false,
            "error": "mask_semantics_mismatch",
            "details": {"required_class_label": "road"}
          },
          "explanation": "实例 ID 和属性作用域均正确，唯一错误是将 road 像素提交为 sidewalk。",
          "source_ref": "SRC-POLICY-IMAGE-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "exercise": {
        "asset_ref": "ASSET-SELF-IMAGE-MASK-EXERCISE-001",
        "input": {
          "instance_id_template": "{class_label}-{object_index:02d}",
          "cases": [
            {
              "case_id": "MASK-SEMANTIC",
              "mode": "semantic",
              "region": "road_pixels",
              "class_label": "road"
            },
            {
              "case_id": "MASK-INSTANCE",
              "mode": "instance",
              "class_label": "bicycle",
              "object_index": 2,
              "same_class_object_count": 2,
              "required_attributes": ["occluded"],
              "observed_attributes": {"occluded": false}
            }
          ]
        },
        "student_action": "按 cases 数组顺序提交 outputs；semantic 不得有实例 ID 或对象属性，instance 必须按模板命名并绑定本实例属性。",
        "answer": {
          "outputs": [
            {
              "case_id": "MASK-SEMANTIC",
              "mask_mode": "semantic",
              "class_label": "road",
              "instance_id": null,
              "attributes": {},
              "merge_with_same_class": true
            },
            {
              "case_id": "MASK-INSTANCE",
              "mask_mode": "instance",
              "class_label": "bicycle",
              "instance_id": "bicycle-02",
              "attributes": {"occluded": false},
              "merge_with_same_class": false
            }
          ]
        },
        "evaluation": {
          "method": "exact_match",
          "version": "1.1.0",
          "normalization": "JSON 对象键顺序忽略；outputs 数组顺序、模式、类别、实例 ID、属性和值必须完全一致。diagnostic_rules 按数组顺序匹配，首个 exact submission 命中；数组顺序即错误优先级。",
          "diagnostic_precedence": "array_order_first_exact_match",
          "diagnostic_rules": [
            {
              "submission": {
                "outputs": [
                  {"case_id": "MASK-SEMANTIC", "mask_mode": "semantic", "class_label": "background", "instance_id": null, "attributes": {}, "merge_with_same_class": true},
                  {"case_id": "MASK-INSTANCE", "mask_mode": "instance", "class_label": "bicycle", "instance_id": "bicycle-02", "attributes": {"occluded": false}, "merge_with_same_class": false}
                ]
              },
              "error_type": "mask_semantics_mismatch",
              "feedback": "MASK-SEMANTIC 的像素类别应为 road，不是 background。",
              "remediation": [
                "按输入的 class_label 恢复 road；不要用实例 ID 或属性改变像素语义类别。"
              ]
            },
            {
              "submission": {
                "outputs": [
                  {"case_id": "MASK-SEMANTIC", "mask_mode": "semantic", "class_label": "road", "instance_id": null, "attributes": {}, "merge_with_same_class": true},
                  {"case_id": "MASK-INSTANCE", "mask_mode": "instance", "class_label": "bicycle", "instance_id": null, "attributes": {"occluded": false}, "merge_with_same_class": false}
                ]
              },
              "error_type": "instance_id_missing",
              "feedback": "MASK-INSTANCE 是实例模式，必须提供唯一 instance_id。",
              "remediation": [
                "使用模板 {class_label}-{object_index:02d} 生成 bicycle-02。"
              ]
            },
            {
