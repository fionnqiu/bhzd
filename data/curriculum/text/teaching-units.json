{
  "schema_version": "1.1.0",
  "data_type": "text",
  "units": [
    {
      "id": "TU-TEXT-DOCUMENT-CLASSIFY-001",
      "data_type": "text",
      "title": "按任务配置完成文档分类",
      "learning_objectives": [
        "区分外部标注工具的选项格式与本项目的类别语义",
        "按照题目声明的单标签约束提交唯一类别"
      ],
      "prerequisites": [
        "CAP-TXT-LABEL-VALIDATE-001"
      ],
      "rule_refs": [
        "KNG-TXT-SINGLE-MULTI-LABEL-001",
        "KNG-TXT-CLASS-EXCLUSION-001"
      ],
      "source_refs": [
        "SRC-LS-CHOICES-PINNED-001",
        "SRC-POLICY-TEXT-TASK3-001"
      ],
      "rule_explanation": "外部格式事实：Label Studio Choices 候选文档用于说明任务可以配置可选项以及单选或多选形式，但不定义本练习的类别含义。本项目语义策略：SRC-POLICY-TEXT-TASK3-001 仅为本项目草稿政策；本单元声明为单标签任务，物流进度询问归入 shipping_query，且标签区分大小写、不自动去除首尾空格，只能原样提交一个配置内标签。",
      "positive_examples": [
        {
          "id": "EX-TEXT-DOCUMENT-POS-001",
          "asset_ref": "ASSET-SELF-TEXT-DOCUMENT-001",
          "input": {
            "text": "订单已经付款，请问大约什么时候发货？",
            "configured_labels": [
              "account_issue",
              "refund_request",
              "shipping_query"
            ],
            "selection_mode": "single"
          },
          "expected": {
            "labels": [
              "shipping_query"
            ]
          },
          "explanation": "文本只询问发货进度；按本项目类别定义选择唯一的 shipping_query。",
          "source_ref": "SRC-POLICY-TEXT-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "negative_examples": [
        {
          "id": "EX-TEXT-DOCUMENT-NEG-001",
          "asset_ref": "ASSET-SELF-TEXT-DOCUMENT-002",
          "input": {
            "text": "订单已经付款，请问大约什么时候发货？",
            "configured_labels": [
              "account_issue",
              "refund_request",
              "shipping_query"
            ],
            "selection_mode": "single",
            "submitted_labels": [
              "refund_request",
              "shipping_query"
            ]
          },
          "expected": {
            "valid": false,
            "error": "invalid_label_cardinality"
          },
          "explanation": "本题明确为单标签任务，提交两个标签违反本项目的基数约束；外部 Choices 格式本身不决定该语义结论。",
          "source_ref": "SRC-POLICY-TEXT-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "exercise": {
        "asset_ref": "ASSET-SELF-TEXT-DOCUMENT-EXERCISE-001",
        "input": {
          "text": "我的包裹三天没有更新物流了，想知道什么时候送到。",
          "configured_labels": [
            "account_issue",
            "refund_request",
            "shipping_query"
          ],
          "selection_mode": "single"
        },
        "student_action": "提交 JSON：在 labels 数组中给出唯一的配置内类别。",
        "answer": {
          "labels": [
            "shipping_query"
          ]
        },
        "evaluation": {
          "method": "exact_match",
          "version": "1.1.0",
          "normalization": "JSON 对象键顺序忽略；labels 数组顺序和值必须与标准答案完全一致；标签区分大小写且不自动去除首尾空格",
          "diagnostic_precedence": "diagnostic_rules 按数组顺序执行严格 JSON 匹配，首个命中规则生效；未命中诊断规则时再执行标准答案匹配，最后使用 incorrect_feedback。",
          "diagnostic_rules": [
            {
              "submission": {
                "labels": [
                  "refund_request",
                  "shipping_query"
                ]
              },
              "error_type": "invalid_label_cardinality",
              "feedback": "单标签任务收到两个标签，违反 selection_mode 声明的基数约束。",
              "remediation": [
                "删除次要标签，只保留一个最能表达主要诉求的配置内标签。"
              ]
            },
            {
              "submission": {
                "labels": [
                  "Shipping_Query"
                ]
              },
              "error_type": "label_normalization_mismatch",
              "feedback": "标签大小写被改写；本项目不执行大小写归一化。",
              "remediation": [
                "从 configured_labels 原样复制 shipping_query，不要改变字符大小写。"
              ]
            },
            {
              "submission": {
                "labels": [
                  "shipping_query "
                ]
              },
              "error_type": "label_normalization_mismatch",
              "feedback": "标签包含额外尾随空格；本项目不自动 trim 标签。",
              "remediation": [
                "从 configured_labels 原样复制 shipping_query，不要增加首尾空格。"
              ]
            },
            {
              "submission": {
                "labels": [
                  "delivery_status"
                ]
              },
              "error_type": "label_not_in_configured_set",
              "feedback": "delivery_status 不属于本题 configured_labels。",
              "remediation": [
                "只从 account_issue、refund_request、shipping_query 中选择一个标签。"
              ]
            },
            {
              "submission": {
                "labels": [
                  "refund_request"
                ]
              },
              "error_type": "document_classification_mismatch",
              "feedback": "提交结构、基数和标签格式均有效，但类别语义与物流进度诉求不符。",
              "remediation": [
                "重新识别文本的主要诉求，并选择表示物流查询的 shipping_query。"
              ]
            }
          ],
          "incorrect_feedback": {
            "error_type": "document_classification_mismatch",
            "feedback": "提交结果未同时满足类别语义和单标签约束。",
            "remediation": [
              "先确认 selection_mode，再只依据文本的主要诉求从 configured_labels 中选择一个标签。"
            ]
          }
        },
        "data_version": "1.1.0",
        "pass_condition": "score == 1.0",
        "capability_refs": [
          "CAP-TXT-CLASSIFY-001"
        ],
        "error_types": [
          "invalid_label_cardinality",
          "label_normalization_mismatch",
          "label_not_in_configured_set",
          "document_classification_mismatch"
        ],
        "asset_authorization": {
          "type": "self-authored",
          "student_use_allowed": true
        }
      },
      "common_errors": [
        "把外部工具的可选项格式误当作本项目的类别定义",
        "在单标签任务中提交多个类别",
        "提交 configured_labels 之外的自由文本"
      ],
      "remediation": [
        "先核对 selection_mode 和 configured_labels，再根据本地类别说明完成同规则练习"
      ],
      "review_records": [],
      "review_status": "draft",
      "student_visible": false
    },
    {
      "id": "TU-TEXT-INTENT-AMBIGUITY-001",
      "data_type": "text",
      "title": "处理意图歧义与允许答案集",
      "learning_objectives": [
        "识别同时包含多个意图信号的边界案例",
        "按照确定性允许答案集区分满分答案、部分得分答案与人工复核"
      ],
      "prerequisites": [
        "CAP-TXT-CLASSIFY-001",
        "CAP-TXT-RELATION-001"
      ],
      "rule_refs": [
        "KNG-TXT-SINGLE-MULTI-LABEL-001",
        "KNG-TXT-INTENT-HIERARCHY-001",
        "KNG-TXT-AMBIGUITY-SET-001"
      ],
      "source_refs": [
        "SRC-LS-CHOICES-PINNED-001",
        "SRC-POLICY-TEXT-TASK3-001"
      ],
      "rule_explanation": "外部格式事实：Label Studio Choices 候选文档仅说明可配置和提交选项，不规定用户意图层级、正确答案或得分。本项目语义策略：SRC-POLICY-TEXT-TASK3-001 仅为本项目草稿政策；当退款状态是显式主诉求而订单状态是背景信息时，refund_status 为满分主意图；若两个意图均被识别但优先级未解决，必须提交 primary_intent 为 null、按证据优先级排列 candidate_intents 并将 ambiguity 标记为 unresolved，固定得 0.5 分且进入人工复核。",
      "positive_examples": [
        {
          "id": "EX-TEXT-INTENT-POS-001",
          "asset_ref": "ASSET-SELF-TEXT-INTENT-001",
          "input": {
            "text": "退款申请已经通过，钱什么时候到账？",
            "configured_intents": [
              "order_status",
              "refund_status"
            ]
          },
          "expected": {
            "primary_intent": "refund_status",
            "candidate_intents": [
              "refund_status"
            ],
            "ambiguity": "none"
          },
          "explanation": "退款到账是唯一明确诉求，按本项目意图政策无需人工复核。",
          "source_ref": "SRC-POLICY-TEXT-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "negative_examples": [
        {
          "id": "EX-TEXT-INTENT-NEG-001",
          "asset_ref": "ASSET-SELF-TEXT-INTENT-002",
          "input": {
            "text": "订单还显示处理中，退款到底什么时候到账？",
            "configured_intents": [
              "order_status",
              "refund_status"
            ],
            "submitted": {
              "primary_intent": "order_status",
              "candidate_intents": [
                "order_status"
              ],
              "ambiguity": "none"
            }
          },
          "expected": {
            "valid": false,
            "error": "ambiguous_intent_ignored"
          },
          "explanation": "提交忽略了显式退款诉求及订单状态背景，未按本地政策记录歧义信息。",
          "source_ref": "SRC-POLICY-TEXT-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "exercise": {
        "asset_ref": "ASSET-SELF-TEXT-INTENT-EXERCISE-001",
        "input": {
          "text": "订单还显示处理中，我申请的退款到底什么时候到账？",
          "configured_intents": [
            "order_status",
            "refund_status"
          ],
          "policy_hint": "显式询问的业务结果优先；未能确定优先级时必须进入人工复核"
        },
        "student_action": "提交 JSON：给出 primary_intent、按证据优先级排列的 candidate_intents 和 ambiguity；无法确定主意图时 primary_intent 必须为 null。",
        "answer": {
          "primary_intent": "refund_status",
          "candidate_intents": [
            "refund_status",
            "order_status"
          ],
          "ambiguity": "resolved_by_explicit_refund"
        },
        "evaluation": {
          "method": "allowed_answers",
          "version": "1.1.0",
          "normalization": "JSON 对象键顺序忽略，因此字段顺序不同但字段和值相同的 unresolved 对象视为等价；candidate_intents 数组顺序和值必须完全一致；仅命中下列允许答案时获得对应固定分数",
          "pass_score": 1.0,
          "manual_review_on_unmatched": false,
          "diagnostic_precedence": "diagnostic_rules 按数组顺序执行严格 JSON 匹配，首个命中规则生效；未命中诊断规则时再按 allowed_answers 顺序匹配，最后使用 incorrect_feedback。",
          "diagnostic_rules": [
            {
              "submission": {
                "primary_intent": "order_status",
                "candidate_intents": [
                  "order_status"
                ],
                "ambiguity": "none"
              },
              "error_type": "ambiguous_intent_ignored",
              "feedback": "提交只保留订单状态，忽略了文本中显式出现的退款到账诉求。",
              "remediation": [
                "保留两个有证据的候选意图，并根据显式问句决定主意图或声明 unresolved。"
              ]
            },
            {
              "submission": {
                "primary_intent": "billing_issue",
                "candidate_intents": [
                  "billing_issue"
                ],
                "ambiguity": "none"
              },
              "error_type": "intent_answer_not_allowed",
              "feedback": "billing_issue 不在 configured_intents 中，且提交未命中任何声明的允许答案。",
              "remediation": [
                "只使用 order_status 与 refund_status，并按本项目歧义表示法重新提交。"
              ]
            }
          ],
          "allowed_answers": [
            {
              "answer": {
                "primary_intent": "refund_status",
                "candidate_intents": [
                  "refund_status",
                  "order_status"
                ],
                "ambiguity": "resolved_by_explicit_refund"
              },
              "score": 1.0,
              "manual_review_required": false,
              "error_type": null,
              "feedback": "已识别退款为显式主诉求，并保留订单状态这一背景意图。",
              "remediation": [
                "无需补强；继续使用相同优先级规则处理下一题。"
              ]
            },
            {
              "answer": {
                "primary_intent": null,
                "candidate_intents": [
                  "refund_status",
                  "order_status"
                ],
                "ambiguity": "unresolved"
              },
              "score": 0.5,
              "manual_review_required": true,
              "error_type": "ambiguous_intent_priority_unresolved",
              "feedback": "已完整保留两个候选意图并明确声明优先级未解决；该规范化表示获得确定性部分分并进入人工复核。",
              "remediation": [
                "复核显式问句指向的业务结果；若证据仍冲突，保持 primary_intent 为 null、保留既定 candidate_intents 顺序并提交人工裁决。"
              ]
            }
          ],
          "manual_review_conditions": [
            {
              "condition": "命中分数小于 1.0 且 manual_review_required 为 true 的允许答案",
              "action": "保留确定性部分得分并进入人工裁决队列"
            },
            {
              "condition": "文本同时出现两个配置内意图，且本地优先级规则无法从显式问句确定主意图",
              "action": "不得自动判为满分；标记 unresolved 并人工复核"
            }
          ],
          "incorrect_feedback": {
            "error_type": "intent_answer_not_allowed",
            "feedback": "提交未命中本单元声明的任何允许答案。",
            "remediation": [
              "对照 configured_intents 与本地优先级规则，保留所有被文本支持的意图后重新提交。"
            ]
          }
        },
        "data_version": "1.1.0",
        "pass_condition": "score == 1.0",
        "capability_refs": [
          "CAP-TXT-INTENT-001",
          "CAP-TXT-AMBIGUITY-001"
        ],
        "error_types": [
          "intent_answer_not_allowed",
          "ambiguous_intent_ignored",
          "ambiguous_intent_priority_unresolved"
        ],
        "asset_authorization": {
          "type": "self-authored",
          "student_use_allowed": true
        }
      },
      "common_errors": [
        "把外部选项格式误当作意图语义权威",
        "只保留一个意图而丢失有文本证据的次要意图",
        "将需要裁决的部分得分答案自动判为满分"
      ],
      "remediation": [
        "逐句标出意图信号，再按本地优先级规则匹配允许答案和人工复核条件"
      ],
      "review_records": [],
      "review_status": "draft",
      "student_visible": false
    },
    {
