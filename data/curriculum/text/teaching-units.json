    {
      "id": "TU-TEXT-NER-BOUNDARY-001",
      "data_type": "text",
      "title": "按字符偏移标注实体边界",
      "learning_objectives": [
        "使用字符起止偏移表达实体选区",
        "根据本地边界政策判断应包含的名称成分和应排除的标点"
      ],
      "prerequisites": [],
      "rule_refs": [
        "KNG-TXT-SPAN-OFFSET-001",
        "KNG-TXT-ENTITY-BOUNDARY-001",
        "KNG-TXT-ENTITY-TYPE-001"
      ],
      "source_refs": [
        "SRC-LS-TEXT-SPANS-PINNED-001",
        "SRC-POLICY-TEXT-TASK3-001"
      ],
      "rule_explanation": "外部格式事实：Label Studio 文本选区候选文档用于说明文本区域以起止字符位置记录，并可绑定区域标签；它不规定具体语料中实体应圈到哪里。当地项目语义策略：SRC-POLICY-TEXT-TASK3-001 仅为本项目草稿政策；偏移采用从 0 开始、end 不含末位的区间，组织全称包含名称后缀，句末标点不计入实体。",
      "boundary_cases": [
        {
          "id": "BC-TEXT-NER-INCLUDE-001",
          "case_type": "include",
          "fragment": "有限公司",
          "rule": "当文本明确给出完整组织名称时，组织类型后缀属于 ORG 实体边界。",
          "source_ref": "SRC-POLICY-TEXT-TASK3-001"
        },
        {
          "id": "BC-TEXT-NER-EXCLUDE-001",
          "case_type": "exclude",
          "fragment": "。",
          "rule": "句末标点用于句法分隔，不属于本项目 ORG 或 PERSON 实体边界。",
          "source_ref": "SRC-POLICY-TEXT-TASK3-001"
        }
      ],
      "positive_examples": [
        {
          "id": "EX-TEXT-NER-POS-001",
          "asset_ref": "ASSET-SELF-TEXT-NER-001",
          "input": {
            "text": "李明在上海交通大学学习。",
            "annotation": {
              "start": 3,
              "end": 9,
              "label": "ORG",
              "text": "上海交通大学"
            }
          },
          "expected": {
            "valid": true
          },
          "explanation": "区间 [3, 9) 完整包含组织名称并排除后续动词和句末标点。",
          "source_ref": "SRC-POLICY-TEXT-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "negative_examples": [
        {
          "id": "EX-TEXT-NER-NEG-001",
          "asset_ref": "ASSET-SELF-TEXT-NER-002",
          "input": {
            "text": "李明在上海交通大学学习。",
            "annotation": {
              "start": 3,
              "end": 7,
              "label": "ORG",
              "text": "上海交通"
            }
          },
          "expected": {
            "valid": false,
            "error": "entity_boundary_incomplete"
          },
          "explanation": "选区漏掉了组织全称中的“大学”，违反本项目的完整名称边界政策。",
          "source_ref": "SRC-POLICY-TEXT-TASK3-001",
          "asset_authorization": {
            "type": "self-authored",
            "student_use_allowed": true
          }
        }
      ],
      "exercise": {
        "asset_ref": "ASSET-SELF-TEXT-NER-EXERCISE-001",
        "input": {
          "text": "王芳加入星河科技有限公司。",
          "labels": [
            "PERSON",
            "ORG"
          ],
          "offset_convention": "zero_based_end_exclusive"
        },
        "student_action": "提交 JSON：按文本顺序给出 PERSON 和 ORG 的 label、start、end 与 text。",
        "answer": {
          "entities": [
            {
              "label": "PERSON",
              "start": 0,
              "end": 2,
              "text": "王芳"
            },
            {
              "label": "ORG",
              "start": 4,
              "end": 12,
              "text": "星河科技有限公司"
            }
          ]
        },
        "evaluation": {
          "method": "exact_match",
          "version": "1.1.0",
          "normalization": "JSON 对象键顺序忽略；entities 数组顺序及所有标签、偏移和文本值必须完全一致",
          "incorrect_feedback": {
            "error_type": "entity_boundary_mismatch",
            "feedback": "至少一个实体的标签、字符边界、表面文本或排列顺序与标准答案不一致。",
            "remediation": [
              "逐字符编号后重新检查 end 不含末位、组织后缀应包含且句末标点应排除。"
            ]
          }
        },
        "data_version": "1.1.0",
        "pass_condition": "score == 1.0",
        "capability_refs": [
          "CAP-TXT-ENTITY-BOUNDARY-001",
          "CAP-TXT-ENTITY-TYPE-001"
        ],
        "error_types": [
          "entity_boundary_mismatch",
          "entity_boundary_incomplete",
          "entity_boundary_includes_punctuation",
          "entity_type_mismatch"
        ],
        "asset_authorization": {
          "type": "self-authored",
          "student_use_allowed": true
        }
      },
      "common_errors": [
        "把 end 当成包含末位的下标",
        "漏掉组织名称后缀",
        "把句末标点圈入实体"
      ],
      "remediation": [
        "给原文逐字符编号，并分别执行必要成分包含检查和标点排除检查"
      ],
