{
  "schema_version": "1.1.0",
  "data_type": "video",
  "units": [
    {
      "id": "TU-VIDEO-BEHAVIOR-EVENT-001",
      "data_type": "video",
      "title": "按行为本体标注视频事件区间",
      "capability_key": "behavior_event",
      "goals": [
        "从结构化视频时间线中选择项目允许的行为事件类别",
        "按项目边界策略提交事件参与轨迹和起止时间"
      ],
      "learning_objectives": [
        "区分 WebVTT 时间提示格式事实与本项目行为本体语义",
        "只从闭合事件词表中选择事件类别并绑定参与轨迹",
        "按项目规定的开始触发点和结束触发点提交半开时间区间"
      ],
      "prerequisites": [
        "CAP-VID-FRAME-ANNOTATE-001"
      ],
      "rule_refs": [
        "KNG-VID-ACTION-TAXONOMY-001",
        "KNG-VID-EVENT-START-END-001"
      ],
      "source_refs": [
        "SRC-W3C-WEBVTT-001",
        "SRC-POLICY-VIDEO-TASK5-001"
      ],
      "rule_explanation": {
        "external_format_facts": [
          {
            "statement": "WebVTT cue timing uses a start timestamp and an end timestamp to locate a timed cue. This format fact does not define an action taxonomy, participant semantics, or the event boundary policy used by this exercise.",
            "source_refs": [
              "SRC-W3C-WEBVTT-001"
            ]
          }
        ],
        "project_policy": {
          "source_ref": "SRC-POLICY-VIDEO-TASK5-001",
          "statement": "本项目开发策略把事件类型限制为 door_entry、door_exit、idle，并用可观察的门内、门槛、门外空间状态区分方向。事件区间统一使用 [start_ms, end_ms) 半开语义：start_ms 对应纳入事件的首个触发时刻，end_ms 对应不再纳入事件的首个时刻。该词表、方向、触发条件和边界语义均不是 WebVTT 外部标准。",
          "event_definitions": {
            "door_entry": {
              "ordered_region_transition": [
                "outside",
                "threshold",
                "inside"
              ],
              "inclusion_criteria": [
                "同一参与轨迹按 outside、threshold、inside 的顺序移动",
                "存在 door_open_start 和 crossing_complete 可观察触发点"
              ],
              "exclusion_criteria": [
                "inside 到 outside 的反向移动",
                "未跨越 threshold 或最终仍在 outside"
              ],
              "start_boundary": "纳入 door_open_start 时刻；该时刻参与者仍在 outside",
              "end_boundary": "排除 crossing_complete 时刻及以后；该时刻首次确认参与者已在 inside"
            },
            "door_exit": {
              "ordered_region_transition": [
                "inside",
                "threshold",
                "outside"
              ],
              "inclusion_criteria": [
                "同一参与轨迹按 inside、threshold、outside 的顺序移动",
                "存在 door_open_start 和 crossing_complete 可观察触发点"
              ],
              "exclusion_criteria": [
                "outside 到 inside 的正向进入",
                "未跨越 threshold 或最终仍在 inside"
              ],
              "start_boundary": "纳入 door_open_start 时刻；该时刻参与者仍在 inside",
              "end_boundary": "排除 crossing_complete 时刻及以后；该时刻首次确认参与者已在 outside"
            },
            "idle": {
              "ordered_region_transition": [
                "same_region",
                "same_region"
              ],
              "inclusion_criteria": [
                "参与者在题目声明的观察窗口内保持同一 observable_region",
                "窗口内没有 threshold 状态和 crossing_complete 触发点"
              ],
              "exclusion_criteria": [
                "出现 outside、threshold、inside 或其反向的完整跨门序列",
                "观察窗口不足以确认位置保持"
              ],
              "start_boundary": "纳入观察窗口的首个合格同区域时刻",
              "end_boundary": "排除观察窗口结束时刻及以后"
            }
          },
          "version": "1.0.0"
        }
      },
      "positive_examples": [
        {
          "id": "EX-VIDEO-BEHAVIOR-EVENT-POS-001",
          "asset_ref": "ASSET-SELF-VIDEO-BEHAVIOR-EVENT-001",
          "input": {
            "timeline_observations": [
              {
                "timestamp_ms": 1000,
                "participant_track_id": "person-01",
                "observable_region": "outside",
                "observation": "person-01 approaches the doorway from outside"
              },
              {
                "timestamp_ms": 2000,
                "participant_track_id": "person-01",
                "observable_region": "outside",
                "observation": "door_open_start by person-01 while outside"
              },
              {
                "timestamp_ms": 5000,
                "participant_track_id": "person-01",
                "observable_region": "threshold",
                "observation": "person-01 crosses the threshold from outside toward inside"
              },
              {
                "timestamp_ms": 6500,
                "participant_track_id": "person-01",
                "observable_region": "inside",
                "observation": "crossing_complete by person-01; first confirmed inside state"
              }
            ]
          },
          "expected": {
            "event_type": "door_entry",
            "participant_track_ids": [
              "person-01"
            ],
            "start_ms": 2000,
            "end_ms": 6500
          },
          "explanation": "事件类别来自闭合词表，参与轨迹完成穿门动作，区间从开门开始到穿越完成。",
          "source_ref": "SRC-POLICY-VIDEO-TASK5-001",
          "asset_authorization": {
            "type": "self-authored",
            "representation": "structured_fixture",
            "contains_personal_data": false,
            "student_use_allowed": true
          }
        }
      ],
      "negative_examples": [
        {
          "id": "EX-VIDEO-BEHAVIOR-EVENT-NEG-001",
          "asset_ref": "ASSET-SELF-VIDEO-BEHAVIOR-EVENT-002",
          "input": {
            "exercise_id": "EXERCISE-VIDEO-BEHAVIOR-EVENT-001",
            "submission": {
              "events": [
                {
                  "event_type": "door_crossing",
                  "participant_track_ids": [
