          "expected": {
            "passed": false,
            "error_type": "action_taxonomy_mismatch"
          },
          "fault_model": {
            "type": "single_fault",
            "field": "events[0].event_type"
          },
          "explanation": "参与轨迹和边界均正确，唯一错误是 door_crossing 不在项目闭合词表中。",
          "source_ref": "SRC-POLICY-VIDEO-TASK5-001",
          "asset_authorization": {
            "type": "self-authored",
            "representation": "structured_fixture",
            "contains_personal_data": false,
