{
  "schema_version": "1.1.0",
  "data_type": "video",
  "units": [
    {
      "id": "TU-VIDEO-BEHAVIOR-EVENT-001",
      "data_type": "video",
      "title": "按行为本体标注视频事件区间",
      "capability_key": "behavior_event",
      "goals": [
        "从结构化视频时间线中选择项目允许的行为事件类别",
        "按项目边界策略提交事件参与轨迹和起止时间"
      ],
      "learning_objectives": [
        "区分 WebVTT 时间提示格式事实与本项目行为本体语义",
        "只从闭合事件词表中选择事件类别并绑定参与轨迹",
        "按项目规定的开始触发点和结束触发点提交半开时间区间"
      ],
      "prerequisites": [
        "CAP-VID-FRAME-ANNOTATE-001"
      ],
      "rule_refs": [
        "KNG-VID-ACTION-TAXONOMY-001",
        "KNG-VID-EVENT-START-END-001"
      ],
      "source_refs": [
        "SRC-W3C-WEBVTT-001",
        "SRC-POLICY-VIDEO-TASK5-001"
      ],
      "rule_explanation": {
        "external_format_facts": [
          {
            "statement": "WebVTT cue timing uses a start timestamp and an end timestamp to locate a timed cue. This format fact does not define an action taxonomy, participant semantics, or the event boundary policy used by this exercise.",
            "source_refs": [
              "SRC-W3C-WEBVTT-001"
            ]
          }
        ],
        "project_policy": {
          "source_ref": "SRC-POLICY-VIDEO-TASK5-001",
          "statement": "本项目开发策略把事件类型限制为 door_entry、door_exit、idle；door_entry 从 door_open_start 的时间戳开始，到 crossing_complete 的时间戳结束，使用 [start_ms, end_ms) 半开区间，并要求绑定完成穿门动作的人员轨迹。该词表、触发条件和边界语义均不是 WebVTT 外部标准。",
          "version": "1.0.0"
        }
      },
      "positive_examples": [
        {
          "id": "EX-VIDEO-BEHAVIOR-EVENT-POS-001",
          "asset_ref": "ASSET-SELF-VIDEO-BEHAVIOR-EVENT-001",
          "input": {
            "timeline_observations": [
              {
                "timestamp_ms": 1000,
                "observation": "person-01 approaches the doorway"
              },
              {
                "timestamp_ms": 2000,
                "observation": "door_open_start by person-01"
              },
              {
                "timestamp_ms": 6500,
                "observation": "crossing_complete by person-01"
              }
            ]
          },
          "expected": {
            "event_type": "door_entry",
            "participant_track_ids": [
              "person-01"
            ],
            "start_ms": 2000,
            "end_ms": 6500
          },
          "explanation": "事件类别来自闭合词表，参与轨迹完成穿门动作，区间从开门开始到穿越完成。",
          "source_ref": "SRC-POLICY-VIDEO-TASK5-001",
          "asset_authorization": {
            "type": "self-authored",
            "representation": "structured_fixture",
            "contains_personal_data": false,
            "student_use_allowed": true
          }
        }
      ],
      "negative_examples": [
        {
          "id": "EX-VIDEO-BEHAVIOR-EVENT-NEG-001",
          "asset_ref": "ASSET-SELF-VIDEO-BEHAVIOR-EVENT-002",
          "input": {
            "submitted": {
              "event_type": "door_crossing",
              "participant_track_ids": [
                "person-01"
              ],
              "start_ms": 1000,
              "end_ms": 7000
            }
          },
          "expected": {
            "valid": false,
            "error": "action_taxonomy_mismatch"
          },
          "explanation": "door_crossing 不在项目闭合词表中，且提交区间使用了接近和关门时刻而非项目事件触发点。",
          "source_ref": "SRC-POLICY-VIDEO-TASK5-001",
          "asset_authorization": {
            "type": "self-authored",
            "representation": "structured_fixture",
            "contains_personal_data": false,
            "student_use_allowed": true
          }
        }
      ],
      "exercise": {
        "exercise_id": "EXERCISE-VIDEO-BEHAVIOR-EVENT-001",
        "exercise_type": "structured_event_annotation",
        "asset_ref": "ASSET-SELF-VIDEO-BEHAVIOR-EVENT-EXERCISE-001",
        "input": {
          "fixture_notice": "This is a structured timeline fixture; no video media is included or implied.",
          "event_vocabulary": [
            "door_entry",
            "door_exit",
            "idle"
          ],
          "participant_track_ids": [
            "person-01",
            "person-02"
          ],
          "timeline_observations": [
            {
              "timestamp_ms": 1000,
              "observation": "person-01 approaches the doorway"
            },
            {
              "timestamp_ms": 2000,
              "observation": "door_open_start by person-01"
            },
            {
              "timestamp_ms": 5000,
              "observation": "person-01 crosses the threshold"
            },
            {
              "timestamp_ms": 6500,
              "observation": "crossing_complete by person-01"
            },
            {
              "timestamp_ms": 7000,
              "observation": "door closes"
            }
          ],
          "interval_convention": "start_inclusive_end_exclusive",
          "policy_version": "1.0.0"
        },
        "response_space": {
          "type": "closed_structured_response",
          "allowed_event_types": [
            "door_entry",
            "door_exit",
            "idle"
          ],
          "allowed_participant_track_ids": [
            "person-01",
            "person-02"
          ],
          "unmatched_submission_handling": "manual_review"
        },
        "student_action": "提交 JSON：events 数组中只给出事件类型、参与轨迹、start_ms 和 end_ms。",
        "answer": {
          "events": [
            {
              "event_type": "door_entry",
              "participant_track_ids": [
                "person-01"
              ],
              "start_ms": 2000,
              "end_ms": 6500
            }
          ]
        },
        "evaluation": {
          "method": "exact_match",
          "version": "1.0.0",
          "normalization": "JSON 对象键顺序忽略；events 数组顺序、事件类型、参与轨迹顺序和毫秒时间值必须完全一致。",
          "diagnostic_precedence": "diagnostic_rules 按数组顺序严格匹配，优先级为事件词表、参与轨迹、开始边界、结束边界；首个命中规则生效，未命中标准答案或诊断样例的提交进入人工复核。",
          "diagnostic_rules": [
            {
              "submission": {
                "events": [
                  {
                    "event_type": "door_crossing",
                    "participant_track_ids": [
                      "person-01"
                    ],
                    "start_ms": 2000,
                    "end_ms": 6500
                  }
                ]
              },
              "error_type": "action_taxonomy_mismatch",
              "feedback": "door_crossing 不在本项目闭合事件词表中。",
              "remediation": [
                "使用事件时间线卡核对允许类别，并将事件类型改为 door_entry。"
              ]
            },
            {
              "submission": {
                "events": [
                  {
                    "event_type": "door_entry",
                    "participant_track_ids": [
                      "person-02"
                    ],
                    "start_ms": 2000,
                    "end_ms": 6500
                  }
                ]
              },
              "error_type": "event_participant_mismatch",
              "feedback": "person-02 未出现在该动作链中，完成穿门动作的是 person-01。",
              "remediation": [
                "沿时间线核对动作执行者，并绑定 person-01。"
              ]
            },
            {
              "submission": {
                "events": [
                  {
                    "event_type": "door_entry",
                    "participant_track_ids": [
                      "person-01"
                    ],
                    "start_ms": 1000,
                    "end_ms": 6500
                  }
                ]
              },
              "error_type": "event_start_boundary_mismatch",
              "feedback": "1000 ms 是接近门口的时刻；项目策略要求从 door_open_start 的 2000 ms 开始。",
              "remediation": [
                "在事件时间线上定位 door_open_start，并将 start_ms 改为 2000。"
              ]
            },
            {
              "submission": {
                "events": [
                  {
                    "event_type": "door_entry",
                    "participant_track_ids": [
                      "person-01"
                    ],
                    "start_ms": 2000,
                    "end_ms": 7000
                  }
                ]
              },
              "error_type": "event_end_boundary_mismatch",
              "feedback": "7000 ms 是关门时刻；项目策略要求在 crossing_complete 的 6500 ms 结束。",
              "remediation": [
                "在事件时间线上定位 crossing_complete，并将 end_ms 改为 6500。"
              ]
            }
          ],
          "correct_feedback": "事件类型、参与轨迹和半开时间区间均符合项目策略。",
          "manual_review_on_unmatched": true,
          "incorrect_feedback": {
            "error_type": "behavior_event_submission_requires_manual_review",
            "feedback": "提交未命中标准答案或已声明诊断样例，不能可靠归入某个具体错误。",
            "remediation": [
              "使用事件时间线卡逐项核对事件词表、参与轨迹和起止触发点，并交由审阅者确认。"
            ]
          }
        },
        "data_version": "1.0.0",
        "pass_condition": "score == 1.0",
        "capability_refs": [
          "CAP-VID-ACTION-EVENT-001"
        ],
        "error_types": [
          "action_taxonomy_mismatch",
          "event_participant_mismatch",
          "event_start_boundary_mismatch",
          "event_end_boundary_mismatch",
          "behavior_event_submission_requires_manual_review"
        ],
        "asset_authorization": {
          "type": "self-authored",
          "representation": "structured_fixture",
          "contains_personal_data": false,
          "student_use_allowed": true
        }
      },
      "learning_path": {
