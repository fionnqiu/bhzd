          "explanation": "目标位于指定帧，类别来自闭合词表，矩形逐项复制结构化可见范围。",
          "source_ref": "SRC-POLICY-VIDEO-TASK5-001",
          "asset_authorization": {
            "type": "self-authored",
            "representation": "structured_fixture",
            "contains_personal_data": false,
            "student_use_allowed": true
