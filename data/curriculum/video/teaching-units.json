              "SRC-CVAT-ANNOTATION-FORMAT-251"
            ]
          }
        ],
        "project_policy": {
          "source_ref": "SRC-POLICY-VIDEO-TASK5-001",
          "statement": "本项目开发策略只评估 frame_index=12；类别词表为 person、vehicle；矩形使用 [x_min, y_min, x_max, y_max] 的零基像素坐标且右下端不包含；每个可见目标恰好提交一次，并按 object_ref 升序排列。以上范围、词表、坐标和排序要求均为本地策略。",
          "version": "1.0.0"
        }
      },
