    {
      "id": "TU-VIDEO-FRAME-ANNOTATION-001",
      "data_type": "video",
      "title": "在指定视频帧上提交类别与几何标注",
      "capability_key": "frame_annotation",
      "goals": [
        "在指定视频帧上完整提交目标类别和矩形几何",
        "按项目坐标与排序策略生成可确定复核的结构化答案"
      ],
      "learning_objectives": [
        "区分 CVAT 可保存的视频帧标注格式事实与本项目答案策略",
        "只标注题目指定帧并使用闭合类别词表",
        "按项目的零基、右下端不包含坐标约定提交矩形"
      ],
      "prerequisites": [
        "CAP-IMG-BOX-ANNOTATE-001",
        "CAP-VID-FRAME-SAMPLE-001"
      ],
      "rule_refs": [
        "KNG-VID-FRAME-ANNOTATION-001"
