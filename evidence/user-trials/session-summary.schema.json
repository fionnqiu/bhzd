{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhzd.local/schemas/session-summary.schema.json",
  "title": "Real trial session summary",
  "description": "Schema for observed real-trial data. It creates no participant, approval, or outcome by default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "participant_role",
    "tasks",
    "started_at",
    "finished_at",
    "observations",
    "revision_decisions",
    "retest",
    "release_approval_ref"
  ],
  "properties": {
    "participant_ref": {
      "type": "string",
      "minLength": 1,
      "description": "An authorized reference to a real participant."
    },
    "participant_role": {
      "type": "string",
      "minLength": 1,
      "description": "The real participant role; no default role is supplied."
    },
    "consent_authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "recorder_ref": {
      "type": "string",
      "minLength": 1
    },
    "release_approval_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to a real human domain-release decision; this schema cannot generate one."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_type",
          "task_ref",
          "completion_status",
          "observations"
        ],
        "properties": {
          "task_type": {
            "type": "string",
            "enum": [
              "text_task",
              "image_task",
              "audio_task",
              "video_task",
              "scenario_comparison",
              "enterprise_task_conversion",
              "structured_diagnosis",
              "pre_remediation_plan"
            ]
          },
          "task_ref": {
            "type": "string",
            "minLength": 1
          },
          "completion_status": {
            "type": "string",
            "minLength": 1
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feedback": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        { "contains": { "properties": { "task_type": { "const": "text_task" } }, "required": ["task_type"] } },
        { "contains": { "properties": { "task_type": { "const": "image_task" } }, "required": ["task_type"] } },
        { "contains": { "properties": { "task_type": { "const": "audio_task" } }, "required": ["task_type"] } },
        { "contains": { "properties": { "task_type": { "const": "video_task" } }, "required": ["task_type"] } },
        { "contains": { "properties": { "task_type": { "const": "scenario_comparison" } }, "required": ["task_type"] } },
        { "contains": { "properties": { "task_type": { "const": "enterprise_task_conversion" } }, "required": ["task_type"] } },
        { "contains": { "properties": { "task_type": { "const": "structured_diagnosis" } }, "required": ["task_type"] } },
        { "contains": { "properties": { "task_type": { "const": "pre_remediation_plan" } }, "required": ["task_type"] } }
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "rationale"],
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "retest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "result"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
